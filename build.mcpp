import mcpp;
import std;

// riscv-virt-rt — everything a consumer needs to build and run for QEMU's
// RISC-V `virt` machine, and nothing it should have to know.
//
// WHAT THIS FILE IS FOR
//
// mcpp knows what a bare-metal TARGET is (an ISA, a calling convention, a code
// model). It deliberately does not know what a BOARD is: which C library, where
// RAM starts, which emulator drives it. That is this package, and swapping it
// for another one is how a user changes boards.
int main() {
    const char* sysroot = mcpp::xpkg_dir("xim", "picolibc-riscv");
    if (!sysroot || !*sysroot) {
        std::cerr << "riscv-virt-rt: xim:picolibc-riscv is declared in "
                     "[xlings].deps but is not installed\n";
        return 1;
    }

    // The profile comes from the target mcpp resolved, so one BSP serves both
    // widths. A second board differs in this table and nowhere else.
    const std::string arch = mcpp::target_arch() ? mcpp::target_arch() : "";
    const bool rv32 = (arch == "riscv32");
    const std::string profile = rv32 ? "rv32imac/ilp32" : "rv64gc/lp64d";
    const std::string rtArch  = rv32 ? "riscv32" : "riscv64";
    const std::string lib = std::format("{}/lib/{}", sysroot, profile);

    // ⚠️ PACKAGE-PRIVATE, and that is the design. These are riscv*-none-elf
    // headers; widening the consumer's include path with them would let it
    // `#include <stdio.h>` and get a header for a target its own translation
    // unit may not be built for. Consumers import the module below instead.
    mcpp::include_dir(std::format("{}/include/{}", sysroot, profile).c_str());

    // Link side — these DO reach the consumer.
    mcpp::link_search(lib.c_str());
    mcpp::link_lib("crt0-semihost");   // pulled from the archive by ENTRY(_start)
    mcpp::link_lib("c");
    mcpp::link_lib("semihost");
    // ⚠️ Not optional. picolibc's printf formats floats through ryu, which does
    // 128-bit shifts; rv64 has no instruction for them, so without the builtins
    // the link fails on __ashlti3/__lshrti3. Note a "does 64-bit division work"
    // check does NOT reach this — rv64gc has a hardware divu.
    mcpp::link_lib(std::format("clang_rt.builtins-{}", rtArch).c_str());
    // The memory layout. The one thing a consumer cannot write for itself.
    mcpp::link_script(std::format("{}/picolibcpp.ld", lib).c_str());

    // How to run it. ⚠️ Absolute path: a bare name resolves through PATH to a
    // shim that dispatches against its own owner home, which is not
    // necessarily the home this build uses.
    if (const char* qemu = mcpp::xpkg_dir("xim", "qemu-riscv"); qemu && *qemu) {
        mcpp::runner(std::format("{}/bin/qemu-system-{}", qemu, rtArch).c_str());
        for (auto a : {"-machine", "virt", "-nographic", "-no-reboot",
                       "-semihosting", "-bios", "none", "-kernel"})
            mcpp::runner(a);
    }

    mcpp::rerun_if_env_changed("MCPP_TARGET_ARCH");
    return 0;
}
